# Single source of truth for the GitHub coordinates used by every release
# artifact: the release workflow, scripts/release/*.sh, and (through
# update-tap.sh, which rewrites their URLs) the Formula and the Cask.
#
# Change these two lines to fork or rename; nothing else hard-codes an owner.
# Shell syntax on purpose — `.` this file from bash, or read it with
# `grep -E '^[A-Z_]+=' | tr -d '"'` from anywhere else.

# owner/repo holding the source and the GitHub Releases the artifacts attach to
RELEASE_REPO="code-better-life/launchkeeper"

# owner/repo of the Homebrew tap (`brew tap code-better-life/launchkeeper`)
TAP_REPO="code-better-life/homebrew-launchkeeper"
